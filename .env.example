# Copy this file to .env and fill in your Supabase project values
# Find these in your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Storage bucket used when products.image_url stores an object path.
VITE_PRODUCT_IMAGE_BUCKET=product-images
# Vercel server-side AI
AI_GATEWAY_API_KEY=
# Optional model override, e.g. openai/gpt-4o-mini
AI_MODEL=
